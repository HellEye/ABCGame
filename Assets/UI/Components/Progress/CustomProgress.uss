.progress-wrapper {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-width: 4px;
    border-color: white;
    padding: 4px;
    padding-right: 14px;
    flex-grow: 0;
}

.ticks-container {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-grow: 0;
    height: 100%;
}

.tick {
    background-color: transparent;
    height: 100%;
    flex-grow: 0;
    margin-left: 10px;
    aspect-ratio: 1;
}

.tick-false {
    --unity-image: url("project://database/Assets/MainMenu/Sprites/UI/Tick_False.png?fileID=2800000&amp;guid=91dae990360e88b4c8e54a986d270be3&amp;type=3#Tick_False");
}

.tick-true {
    --unity-image: url("project://database/Assets/MainMenu/Sprites/UI/Tick_True.png?fileID=2800000&amp;guid=c76eab2c0bd8d3ec588f4c569201f58d&amp;type=3#Tick_True");
}

.progress-wrapper .progress-icon {
    height: 100%;
    max-height: 100%;
    flex-grow: 0;
    margin-left: 10px;
    aspect-ratio: 1;

}

