.popup-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.3);
    display: none;
    align-items: center;
    justify-content: center;
}

.popup-backdrop.show {
    display: flex;
}

.popup-wrapper {
    min-width: 30px;
    min-height: 30px;
    border-radius: 30px;
    border-color: #404040;
    border-width: 5px;
    background-color: #b0b0b0;
}

.difficulty-popup-wrap {
    display: flex;
    flex-direction: column;
    /*min-width: 60%;
    max-width: 80%;*/
    width: 1200px;
    height: 720px;
    padding: 20px 10px;
    
    background-color: blueviolet;
}

.popup-body {
    width:100%;
    height:78%;
    flex-direction:row;
}

.popup-body-column-side {
    width:25%;
    align-items: flex-end;
}

.popup-body-column-center {
    width:50%;
    align-items: center;
    margin-top: 50px;
}

.popup-footer {
    width:100%;
    height:22%;
    align-items: center;
}

.difficulty-text {
    font-size: 50px;
    color: black;
    margin-top: 30px;
}

.difficulty-buttons {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
}

.difficulty-close-btn {
    width: 80px;
    height: 80px;
}

.difficulty-icon-btn {
    /*width: 90%;
    height: 70%;

    position: relative;

    border-radius: 30px;
    border-width: 4px;
