
.difficulty-popup .popup-wrapper {
    border-radius: 70px;
    min-width: 60%;
    min-height: 60%;
    overflow: hidden;
    flex-direction: column;
    padding: 20px 10px;
    background-image: url("project://database/Assets/MainMenu/UITest/popup_background.png?fileID=5831718440945433681&guid=c1611caa6a633de4b817b4ff308e9555&type=3#popup_background_0");
}

#DifficultyPopupInstance {
    align-items: center;
}

.difficulty-popup #difficultyIcon {
    align-items: center;
    justify-content: center;
    flex-shrink: 1;
    margin-bottom: 5%;
}

.difficulty-popup-footer {
    width: 100%;
    height: 20%;
    flex-shrink: 0;
    align-items: center;
    flex-grow: 1;
    min-height: 100px;
}

.difficulty-text {
    font-size: 50px;
    color: black;
}

.difficulty-popup .card-title {
    color: black;
    font-size: 40px;
    margin-top: 30px;
}

.difficulty-buttons {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
}

.difficulty-close-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 50px;
    height: 50px;
    border-radius: 0;
    border-width: 0;
    padding: 0;
    margin: 0;
    background-color: transparent;
}

.difficulty-close-btn .unity-image {
    --unity-image-tint-color: rgba(220, 220, 220, 1);
}

.difficulty-close-btn:hover .unity-image {
    --unity-image-tint-color: rgb(255, 255, 255);
}


.difficulty-icon-btn .minigame-card-view-root {
    height: 350px;
    width: auto;
}

.difficulty-icon-btn .minigame-card:hover {
    scale: 1;
}

.difficulty-btn {
    width: 26%;
    height: 100%;
    border-radius: 30px;
    border-width: 10px;
    border-color: black;

    font-size: 40px;

}

.difficulty-btn-easy {
    background-color: #97E545;
    border-color: #97E545;
}

.difficulty-btn-easy:active {
    background-color: #364626;
}

.difficulty-btn-medium {
    background-color: #FFD900;
    border-color: #FFD900;
}

.difficulty-btn-medium:active {
    background-color: #4b4318;
}

.difficulty-btn-hard {
    background-color: #FF8000;
    border-color: #FF8000;
}

.difficulty-btn-hard:active {
    background-color: #4b3218;
}

