<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">
    <Style
        src="project://database/Assets/MainMenu/UITest/USS/Common/Cards.uss?fileID=7433441132597879392&amp;guid=109dd6c00301f7f419f83a4f96311992&amp;type=3#Cards"/>
    <ui:VisualElement class="minigame-card-view-wrapper">

        <ui:VisualElement name="Card" class="minigame-card" style="flex-grow: 1;">
            <ui:VisualElement name="Corner" class="favorite-corner"
                              style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/favorite-corner.png?fileID=2800000&amp;guid=4c7a2df86ee26d74995165c138634137&amp;type=3#favorite-corner&quot;); font-size: 0;">
                <ui:Image name="CornerBackground" class="favorite-corner-background"/>
                <ui:Image name="Heart" class="favorite-heart"/>
            </ui:VisualElement>
            <ui:Image name="Thumbnail" class="card-thumbnail"/>
        </ui:VisualElement>
        <ui:Label text="Label" name="Title" class="card-title" style="-unity-text-align: upper-center;"/>
    </ui:VisualElement>
</ui:UXML>


