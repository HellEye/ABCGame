/* ==========================================================
   MINIGAME CARD
   Base design size: 300 x 200 (3:2)
   ========================================================== */

.minigame-card {
    width: 100%;
    position: relative;

    border-radius: 30px;
    border-width: 4px;
    border-color: white;

    background-color: rgb(235, 235, 235);

    flex-direction: column;

    justify-content: flex-end;

    align-items: center;

    transition-property: scale;
    transition-duration: 0.15s;

    overflow: visible;
    aspect-ratio: 1.5;
}

.minigame-card-view-root {
    width: 300px;
    height: 200px;
    max-width: 300px;
    flex-grow: 1;


}

.minigame-card-view-wrapper {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    margin: 0;
    margin-bottom: 5%;
}

/* ==========================================================
   THUMBNAIL
   ========================================================== */

.card-thumbnail {
    flex-shrink: 1;

    -unity-background-scale-mode: scale-to-fit;
    /*background-color: red;*/

    border-radius: 20px;
}

.card-title {
    flex-shrink: 0;
    width: 100%;
}

/* ==========================================================
   FAVOURITE CORNER
   ========================================================== */

.favorite-corner {
    position: absolute;

    left: -10px;
    top: -10px;

    width: 50px;
    height: 50px;

    overflow: visible;
}

/* Blue triangle image */

.favorite-corner-background {
    /*position: absolute;*/

    left: 0;
    top: 0;

    width: 100%;
    height: 100%;

    -unity-background-scale-mode: stretch-to-fill;
}

/* ==========================================================
   HEART
   ========================================================== */

.favorite-heart {
    position: absolute;

    left: 5px;
    top: 5px;

    width: 50%;
    height: 50%;

    flex-shrink: 0;

    -unity-background-scale-mode: scale-to-fit;

    -unity-image-tint-color: white;
}

/* ==========================================================
   TITLE
   ========================================================== */

.card-title {
    height: auto;
    flex-shrink: 0;

    -unity-text-align: middle-center;

    font-size: 24px;

    color: rgb(70, 70, 70);

    -unity-font-style: bold;
}

.minigame-card:hover {
    scale: 1.06;
}

.pressed {
    scale: 0.98;
}