<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">
    <Style
        src="project://database/Assets/MainMenu/UITest/USS/Common/Buttons.uss?fileID=7433441132597879392&amp;guid=0719abd2b9b000047a5f18c51626a4f6&amp;type=3#Buttons"/>
    <Style
        src="project://database/Assets/MainMenu/UITest/USS/Common/Common.uss?fileID=7433441132597879392&amp;guid=fdae795555f391042bf8284f5e54613b&amp;type=3#Common"/>
    <Style
        src="project://database/Assets/MainMenu/UITest/USS/Screens/MainMenu.uss?fileID=7433441132597879392&amp;guid=4f0be8976d0182a418e8791fea9b8142&amp;type=3#MainMenu"/>
    <Style
        src="project://database/Assets/MainMenu/UITest/USS/Common/Cards.uss?fileID=7433441132597879392&amp;guid=109dd6c00301f7f419f83a4f96311992&amp;type=3#Cards"/>
    <Style
        src="project://database/Assets/UI/Popup/Popup.uss?fileID=7433441132597879392&amp;guid=38698b2c507c92d169067d14f4939105&amp;type=3#Popup"/>
    <Style
        src="project://database/Assets/MainMenu/UITest/USS/Screens/DifficultyPopup.uss?fileID=7433441132597879392&amp;guid=b1fa0103fb1911ad194ad10fd49e44f0&amp;type=3#DifficultyPopup"/>
    <ui:VisualElement name="MainMenu" class="main-menu screen" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="Background" class="background"
                          style="flex-grow: 1; background-image: url(&quot;project://database/Assets/MainMenu/UITest/menu_background.png?fileID=2800000&amp;guid=924df9d52c2d6f34db97ffc1a1baa969&amp;type=3#menu_background&quot;);"/>
        </ui:VisualElement>
    
    <ui:VisualElement name="MainMenuOpening" class="main-menu screen" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:Image name="Logo" class="logo"
                  style="background-image: url(&quot;project://database/Assets/MainMenu/UITest/logo.png?fileID=2800000&amp;guid=3f22bb56d73a6df429a91f4be2fcfb07&amp;type=3#logo&quot;);"/>
        <ui:Label text="naciśnij aby rozpocząć" name="PressToStart" class="start-text press-start press-to-start"
                  style="align-self: center; justify-content: center; align-items: center; align-content: auto; background-position-x: center; background-position-y: center; -unity-text-align: middle-center; position: absolute; top: 66%; left: auto; bottom: auto; right: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Super%20Warming.ttf?fileID=12800000&amp;guid=5b62f8b0e30230e4a8cd6d2a283c7f21&amp;type=3#Super Warming&quot;); font-size: 60px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="MainMenuMinigame" class="main-menu screen" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="CardGrid"/>
        <ui:VisualElement name="CardContainer"/>
    </ui:VisualElement>
    <Popup name="DifficultyPopup" is-open="false" class="difficulty-popup">
        <ui:VisualElement name="DifficultyPopupWrap" class="difficulty-popup-wrap">
            <ui:VisualElement name="DifficultyPopupBody" class="difficulty-popup-body">
                <ui:VisualElement name="difficultyIcon" class="difficulty-icon-btn"/>
                <ui:Label name="DifficultyText" text="Nazwa Minigry" class="difficulty-text"/>
                <ui:Button name="DifficultyPopupCloseBtn"
                           icon-image="project://database/Assets/MainMenu/UITest/Cancel.png?fileID=2800000&amp;guid=bc74311713d4f2c48bd2a6c8d986abd4&amp;type=3#Cancel"
                           class="difficulty-close-btn"/>
            </ui:VisualElement>
            <ui:VisualElement name="DifficultyPopupFooter" class="difficulty-popup-footer">
                <ui:VisualElement name="DifficultyButtons" class="difficulty-buttons"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </Popup>
</ui:UXML>
