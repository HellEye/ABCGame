    <ui:Button name="SettingsButton" class="settings-button" style="background-image: url(&quot;project://database/Assets/MainMenu/UITest/Settings.png?fileID=7886631795410796208&amp;guid=533696a6e6f021445ada040120f3474b&amp;type=3#Settings_0&quot;);"/>
    <Popup name="DifficultyPopup" is-open="false" class="difficulty-popup">
        <ui:Instance template="DifficultyPopup" name="DifficultyPopupInstance" style="min-width: auto; width: 100%; height: 100%;"/>
    </Popup>
    <Popup name="settings-popup" is-open="false" style="width: 100%; height: 100%;">
        <ui:Instance template="Settings_UXML"/>
    </Popup>
