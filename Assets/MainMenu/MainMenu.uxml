<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">
    <ui:Template name="DifficultyPopup"
                 src="project://database/Assets/MainMenu/DifficultyPopup/DifficultyPopup.uxml?fileID=9197481963319205126&amp;guid=78ad3406a84087762b5859fcf30a1888&amp;type=3#DifficultyPopup"/>
    <ui:Template name="Settings_UXML"
                 src="project://database/Assets/MainMenu/Settings/Settings_UXML.uxml?fileID=9197481963319205126&amp;guid=7f24f5444bb59ff408dad1174496556c&amp;type=3#Settings_UXML"/>
    <Style
        src="project://database/Assets/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=4f0be8976d0182a418e8791fea9b8142&amp;type=3#MainMenu"/>
    <ui:VisualElement name="MainMenu" class="main-menu screen" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="Background" class="background"
                          style="flex-grow: 1; background-image: url(&quot;project://database/Assets/MainMenu/Sprites/Background/menu_background.png?fileID=2800000&amp;guid=924df9d52c2d6f34db97ffc1a1baa969&amp;type=3#menu_background&quot;);"/>
    </ui:VisualElement>
    <ui:VisualElement name="MainMenuOpening" class="main-menu screen" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:Image name="Logo" class="logo"
                  style="background-image: url(&quot;project://database/Assets/MainMenu/Sprites/Logo/logo.png?fileID=2800000&amp;guid=3f22bb56d73a6df429a91f4be2fcfb07&amp;type=3#logo&quot;);"/>
        <ui:Label text="naciśnij aby rozpocząć" name="PressToStart" class="start-text press-start press-to-start"
                  style="align-self: center; justify-content: center; align-items: center; align-content: auto; background-position-x: center; background-position-y: center; -unity-text-align: middle-center; position: absolute; top: 66%; left: auto; bottom: auto; right: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Super%20Warming.ttf?fileID=12800000&amp;guid=5b62f8b0e30230e4a8cd6d2a283c7f21&amp;type=3#Super Warming&quot;); font-size: 60px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="MainMenuMinigame" class="main-menu screen" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement class="card-grid-container">
            <ui:VisualElement name="CardGrid"/>
        </ui:VisualElement>
        <ui:VisualElement name="CardContainer"/>
    </ui:VisualElement>
    <ui:Button name="SettingsButton" class="settings-button"
               style="background-image: url(&quot;project://database/Assets/MainMenu/Sprites/UI/Settings.png?fileID=7886631795410796208&amp;guid=533696a6e6f021445ada040120f3474b&amp;type=3#Settings_0&quot;);"/>
    <Popup name="DifficultyPopup" is-open="false" class="difficulty-popup">
        <ui:Instance template="DifficultyPopup" name="DifficultyPopupInstance"
                     style="min-width: auto; width: 100%; height: 100%;"/>
    </Popup>
    <Popup name="settings-popup" is-open="false" style="width: 100%; height: 100%;">
        <ui:Instance template="Settings_UXML"/>
    </Popup>
</ui:UXML>
