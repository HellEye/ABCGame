<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>com.github.csukuangfj.piper.phonemize.runtime.android-x64</id>
    <version>1.5.9</version>
    <title>piper-phonemize android-x64 v1.5.9</title>
    <authors>Michael Hansen, Fangjun Kuang</authors>
    <license type="expression">GPL-3.0-or-later</license>
    <licenseUrl>https://licenses.nuget.org/GPL-3.0-or-later</licenseUrl>
    <projectUrl>https://github.com/csukuangfj/piper-phonemize</projectUrl>
    <description>.NET native android-x64 wrapper for the piper-phonemize project.

    In general, you don't need to use this package directly.

    Please use https://www.nuget.org/packages/com.github.csukuangfj.piper.phonemize instead</description>
    <tags>phonemize text-to-speech tts espeak-ng phonemes ipa offline</tags>
    <repository type="git" url="https://github.com/csukuangfj/piper-phonemize" />
    <dependencies>
      <group targetFramework="net10.0" />
      <group targetFramework=".NETFramework2.0" />
      <group targetFramework=".NETFramework3.5" />
