<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">
    <Style
        src="project://database/Assets/Game/Shared/UI/GameUI.uss?fileID=7433441132597879392&amp;guid=b548f1e591b0515e5bc077693b83dc27&amp;type=3#GameUI"/>
    <Style
        src="project://database/Assets/UI/globals.uss?fileID=7433441132597879392&amp;guid=f379efdc614e19cb0b2380346f56bde5&amp;type=3#globals"/>
    <ui:VisualElement class="game-top-row">
        <ui:Button name="PauseButton"
                   icon-image="project://database/Assets/MainMenu/Sprites/UI/Pause.png?fileID=2800000&amp;guid=72d6b355c58c06a97acec3944a98ad7b&amp;type=3#Pause"
                   class="button  no-border pause-button"/>
        <ui:Button name="OpenInstructionsButton" text="Zadanie"
                   icon-image="project://database/Assets/MainMenu/Sprites/UI/Task.png?fileID=2800000&amp;guid=6cf47722b732e47449f6fd9a8120fe85&amp;type=3#Task"
                   class="button   light no-border task-button"/>
        <CustomProgress name="ProgressBar" discrete-steps="3" value="5" max="5"
                        image-false="project://database/Assets/MainMenu/Sprites/UI/Tick_False.png?fileID=2800000&amp;guid=91dae990360e88b4c8e54a986d270be3&amp;type=3#Tick_False"
                        image-true="project://database/Assets/MainMenu/Sprites/UI/Tick_True.png?fileID=2800000&amp;guid=c76eab2c0bd8d3ec588f4c569201f58d&amp;type=3#Tick_True">
            <Bindings>
                <ui:DataBinding property="Value" data-source-path="Progress" binding-mode="ToTarget"/>
                <ui:DataBinding property="Max" data-source-path="TotalProgress" binding-mode="ToTarget"/>
                <ui:DataBinding property="DiscreteSteps" data-source-path="TotalProgress" binding-mode="ToTarget"/>
            </Bindings>
        </CustomProgress>
    </ui:VisualElement>
    <Popup name="InstructionPopup" initial-open="true">
        <ui:VisualElement class="instruction-title-wrap">
            <ui:Label text="Zadanie" class="instruction-title"/>
        </ui:VisualElement>
        <ui:VisualElement class="instruction-text-wrap">
            <ui:Button name="InstructionAudioButton"
                       icon-image="project://database/Assets/MainMenu/Sprites/UI/Sound.png?fileID=2800000&amp;guid=643f9c37510c3bfd0a1d45f47ac0e389&amp;type=3#Sound"
                       class="instruction-audio"/>
            <ui:Label name="instruction-text" text="Lorem ipsum instrukcja do gry" class="instruction-text"/>
        </ui:VisualElement>
        <ui:VisualElement class="instruction-image-wrap">
            <ui:Image name="instruction-image" class="instruction-image"/>
        </ui:VisualElement>
        <ui:VisualElement class="instruction-continue-button-wrap">
            <ui:Button name="InstructionContinueButton" text="Gram!" class="button easy"/>
        </ui:VisualElement>
    </Popup>
    <Popup name="EndGamePopup" close-on-backdrop="false" is-open="false">
        <ui:VisualElement class="end-game-wrap">
            <ui:Label text="Gratulacje!" class="only-end title"/>
            <ui:Label text="Menu" class="only-pause title"/>
            <ui:VisualElement>
                <ui:Button name="ContinueButton" text="Kontynuuj" class="button only-pause easy"/>
                <ui:Button name="RestartButton" text="Restart" class="button warning"/>
                <ui:Button name="ExitButton" text="Wróć do Menu" class="button danger"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </Popup>
</ui:UXML>
