@import url("project://database/Assets/UI/globals.uss?fileID=7433441132597879392&guid=f379efdc614e19cb0b2380346f56bde5&type=3#globals");

.objective-label-wrap {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 32px;
}

.end-game-wrap {
    padding: 20px;
}

.end-game-wrap .title {
    margin-bottom: 30px;
}

.end-game-wrap Button {
    margin-bottom: 10px;
}

.label-wrap {
    background-color: rgba(102, 102, 102, 0.33);
    border-radius: 8px;
    border-width: 3px;
    border-color: rgb(136, 136, 136);
    width: 100%;
    height: 100%;
    padding: 16px;
}

.objective-label {
    -unity-text-align: middle-center;
    font-size: 60px;
    color: white;
    white-space: normal;
}

.only-pause {
    display: none;
}

.only-end {
    display: none;
}

.end-menu .only-end {
    display: flex;
}

.pause-menu .only-pause {
    display: flex;
}

.game-top-row {
    height: 60px;
    position: absolute;
    top: 30px;
    left: 30px;
    right: 30px;
    flex-direction: row;
    align-items: center;
}

.game-top-row > * {
    margin-left: 30px;
    flex-grow: 0;
    height: 100%;
}


.game-top-row .task-button {
    flex-grow: 0;
}

.game-top-row .task-button .unity-image {

    margin-right: 10px;
}

.game-top-row .pause-button {
    background-color: transparent;
    border-color: transparent;
    padding: 0;
}

.game-top-row .pause-button .unity-image {
    height: 100%;
    padding: 0;
    margin: 0;
    width: 60px;
}


#InstructionPopup .popup-wrapper {
    width: 90%;
    height: 90%;
    background-color: white;
    padding: 5%;
    --left-spacing: 60px;
    align-items: flex-start;
    --gap: 20px;
}


.instruction-title-wrap {
    height: 50px;
    margin-bottom: var(--gap);
    padding: 5px 10px;
    margin-left: var(--left-spacing);
    border-radius: 25px;
    background-color: var(--color-accent);
    flex-grow: 0;
    width: auto;
}

.instruction-text-wrap {
    flex-grow: 1;
    width: 100%;
    margin-bottom: var(--gap);
    position: relative;
    flex-direction: row;
}

.instruction-audio {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    flex-grow: 0;
    -unity-image-tint-color: white;
    padding: 0;
    margin: 0;
    background-color: transparent;
    border-width: 0;
}

.instruction-audio Image, .instruction-audio TextElement {
    margin: 0;
}

#instruction-text {
    margin-left: 16px;
    color: var(--color-text-light);
    font-size: 30px;
    white-space: wrap;
    padding-right: 30px;
}

#InstructionPopup .instruction-title {
    -unity-text-align: middle-center;
    font-size: 36px;
    color: var(--color-text-dark);
}

.instruction-image-wrap {
    align-items: center;
    justify-content: center;
    margin-bottom: var(--gap);
    width: 100%;
    align-items: center;
    justify-content: center;
}

.instruction-image {
    flex-shrink: 0;
    max-width: 600px;
    min-height: 80px;
    max-height: 150px;
    width: 100%;
}

#InstructionContinueButton {
    width: 300px;
    max-width: 100%;
    min-width: 100px;
}

.instruction-continue-button-wrap {
    width: 100%;
    align-items: center;
    justify-content: center;
}
