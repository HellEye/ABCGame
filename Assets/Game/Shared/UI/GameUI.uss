@import url("project://database/Assets/UI/globals.uss?fileID=7433441132597879392&guid=f379efdc614e19cb0b2380346f56bde5&type=3#globals");

.objective-label-wrap {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 32px;
}

.end-game-wrap {
    padding: 20px;
}

.end-game-wrap .title {
    margin-bottom: 30px;
}

.end-game-wrap Button {
    margin-bottom: 10px;
}

.label-wrap {
    background-color: rgba(102, 102, 102, 0.33);
    border-radius: 8px;
    border-width: 3px;
    border-color: rgb(136, 136, 136);
    width: 100%;
    height: 100%;
    padding: 16px;
}

.objective-label {
    -unity-text-align: middle-center;
    font-size: 60px;
    color: white;
    white-space: normal;
}

.only-pause {
    display: none;
}

.only-end {
    display: none;
}

.end-menu .only-end {
    display: flex;
}

.pause-menu .only-pause {
    display: flex;
}


.pause-button {
    position: absolute;
    right: 25px;
    top: 25px;
    background-color: transparent;
    border-color: transparent;
    width: 50px;
    height: 50px;
    background-image: url("project://database/Assets/MainMenu/Sprites/UI/Return.png?fileID=-3092956421908063085&guid=dc4806f0a1d807d428e0a1d60a512374&type=3#Return_0");
}
